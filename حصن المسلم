    function saveLast() {
      if (!state.cat) return;
      var finished = (state.idx === state.items.length - 1 && state.remaining === 0);
      if (finished) { store.del('last'); return }
      store.set('last', { c: state.cat, i: state.idx, r: state.remaining });
    }

    function renderDhikr() {
      var it = state.items[state.idx], total = state.items.length;
      var cat = CATEGORIES.filter(function (c) { return c.id === state.cat })[0] || { name: 'الأذكار' };
      $('#listTitle').textContent = cat.name;
      $('#listSub').textContent = 'الذكر ' + arNum(state.idx + 1) + ' من ' + arNum(total);
      var done = (it.n - state.remaining) / it.n;
      $('#progFill').style.width = (((state.idx + done) / total) * 100) + '%';
      var card = $('#dhikrCard');
      card.classList.remove('done');
      card.classList.toggle('quran', !!it.q);
      var tag = $('#dhikrTag');
      if (it.q) { tag.style.display = ''; tag.textContent = 'آية' } else tag.style.display = 'none';
      $('#dhikrText').innerHTML = ornament(it.x);
      $('#dhikrCount').textContent = '⟳ ' + it.l;
      $('#dhikrSource').textContent = it.s || '';
      var v = $('#dhikrVirtue');
      if (it.v) { v.style.display = ''; v.innerHTML = '<b>الفضل: </b>' + it.v } else v.style.display = 'none';
      renderCounter();
      $('#btnPrev').disabled = (state.idx === 0);
      $('#counterBtn').classList.remove('done');
    }

    function renderCounter() {
      var it = state.items[state.idx];
      $('#counterNum').textContent = arNum(state.remaining);
      $('#counterSub').textContent = 'من ' + arNum(it.n);
      var prog = (it.n - state.remaining) / it.n;
      $('#ringProg').style.strokeDashoffset = RING_C * (1 - prog);
    }

    function tapCount() {
      var it = state.items[state.idx];
      if (state.remaining <= 0) return;
      state.remaining--;
      vibrate(12);
      var p = document.createElement('span'); p.className = 'pulse';
      $('#counterBtn').appendChild(p);
      setTimeout(function () { p.remove() }, 600);
      if (state.remaining === 0) {
        $('#counterBtn').classList.add('done');
        $('#dhikrCard').classList.add('done');
        $('#counterNum').textContent = '✓';
        $('#counterSub').textContent = 'اكتمل';
        $('#progFill').style.width = (((state.idx + 1) / state.items.length) * 100) + '%';
        vibrate(40);
        var d = getDaily(); d.total++; store.set('daily', d);
        state.doneSet[state.idx] = true;
        saveLast();
        setTimeout(function () {
          if (state.idx < state.items.length - 1) {
            state.idx++;
            state.remaining = state.items[state.idx].n;
            renderDhikr(); saveLast();
          } else {
            showDonePanel();
          }
        }, 900);
      } else {
        renderCounter(); saveLast();
      }
    }

    function showDonePanel() {
      $('#doneMsg').textContent = 'أتممتَ ' + catName(state.cat) + ' كاملة (' + arNum(state.items.length) + ' ذكرًا). نسأل الله أن يتقبّل منك صالح الأعمال.';
      $('#donePanel').classList.add('show');
      store.del('last');
    }

    $('#counterBtn').addEventListener('click', tapCount);
    $('#dhikrCard').addEventListener('click', tapCount);
    $('#btnNext').addEventListener('click', function () {
      if (state.idx < state.items.length - 1) {
        state.idx++; state.remaining = state.items[state.idx].n; renderDhikr(); saveLast();
      } else showDonePanel();
    });
    $('#btnPrev').addEventListener('click', function () {
      if (state.idx > 0) { state.idx--; state.remaining = state.items[state.idx].n; renderDhikr(); saveLast() }
    });
    $('#btnReset').addEventListener('click', function () {
      state.remaining = state.items[state.idx].n; renderDhikr();
      $('#counterBtn').classList.remove('done'); $('#dhikrCard').classList.remove('done');
    });
    $('#btnBack').addEventListener('click', function () {
      $('#donePanel').classList.remove('show'); renderHome(); switchScreen('home');
    });
    $('#doneHome').addEventListener('click', function () {
      $('#donePanel').classList.remove('show'); renderHome(); switchScreen('home');
    });
    $('#doneAgain').addEventListener('click', function () {
      $('#donePanel').classList.remove('show'); openCategory(state.cat, 0);
    });

    $('#btnShare').addEventListener('click', function () {
      var it = state.items[state.idx]; if (!it) return;
      var txt = it.x + '\n\n📿 ' + it.l + (it.s ? '\n' + it.s : '') + '\n— تطبيق حصن المسلم';
      if (navigator.share) {
        navigator.share({ title: 'حصن المسلم', text: txt }).catch(function () { });
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(function () { toast('تم نسخ الذكر ✓') });
      }
    });

    var FS_ORDER = ['s', 'm', 'l', 'xl'];
    function setFS(f) {
      document.body.dataset.fs = f; store.set('fs', f); syncSettings();
    }
    $('#btnFontUp').addEventListener('click', function () {
      var i = FS_ORDER.indexOf(document.body.dataset.fs);
      setFS(FS_ORDER[Math.min(i + 1, 3)]);
    });
    $('#btnFontDn').addEventListener('click', function () {
      var i = FS_ORDER.indexOf(document.body.dataset.fs);
      setFS(FS_ORDER[Math.max(i - 1, 0)]);
    });

    $('#searchInput').addEventListener('input', function () {
      var q = normalize(this.value.trim());
      var box = $('#searchResults');
      if (!q) { box.innerHTML = '<p class="empty">ابحث في نصوص جميع الأذكار<br/>مثال: «الاستغفار» أو «العافية»</p>'; return }
      var hits = [];
      ADHKAR.forEach(function (a, gi) {
        if (normalize(a.x).indexOf(q) > -1 || normalize(catName(a.c)).indexOf(q) > -1)
          hits.push({ a: a, gi: gi });
      });
      if (!hits.length) { box.innerHTML = '<p class="empty">لا توجد نتائج مطابقة</p>'; return }
      box.innerHTML = hits.slice(0, 60).map(function (h) {
        var snip = h.a.x.length > 110 ? h.a.x.slice(0, 110) + '…' : h.a.x;
        return '<button class="res-item" data-gi="' + h.gi + '">'
          + '<p class="snip">' + ornament(snip) + '</p>'
          + '<div class="rmeta"><span class="rchip g">' + catName(h.a.c) + '</span>'
          + '<span class="rchip d">⟳ ' + h.a.l + '</span></div></button>';
      }).join('');
      $$('#searchResults .res-item').forEach(function (b) {
        b.addEventListener('click', function () {
          var gi = +b.dataset.gi, target = ADHKAR[gi];
          var list = itemsOf(target.c), idx = list.indexOf(target);
          openCategory(target.c, idx < 0 ? 0 : idx);
        });
      });
    });

    var PHRASES = ['سُبْحَانَ اللَّهِ', 'الْحَمْدُ لِلَّهِ', 'اللَّهُ أَكْبَرُ', 'لَا إِلَهَ إِلَّا اللَّهُ', 'أَسْتَغْفِرُ اللَّهَ'];
    var TARGETS = [33, 100, 0];
    var tState = { count: 0, target: 33, phrase: 0, total: 0 };

    function renderTasbihChips() {
      $('#phraseChips').innerHTML = PHRASES.map(function (p, i) {
        return '<button class="chip' + (i === tState.phrase ? ' on' : '') + '" data-i="' + i + '">' + p + '</button>';
      }).join('');
      $('#targetChips').innerHTML = TARGETS.map(function (t) {
        return '<button class="chip sm' + (t === tState.target ? ' on' : '') + '" data-t="' + t + '">'
          + (t === 0 ? 'بدون حدّ' : 'الهدف ' + arNum(t)) + '</button>';
      }).join('');
      $$('#phraseChips .chip').forEach(function (b) {
        b.addEventListener('click', function () { tState.phrase = +b.dataset.i; tState.count = 0; renderTasbihChips(); renderTasbih() });
      });
      $$('#targetChips .chip').forEach(function (b) {
        b.addEventListener('click', function () { tState.target = +b.dataset.t; tState.count = 0; renderTasbihChips(); renderTasbih() });
      });
    }

    function renderTasbih() {
      $('#tNum').textContent = arNum(tState.count);
      $('#tSub').textContent = tState.target ? 'من ' + arNum(tState.target) : PHRASES[tState.phrase];
      var prog = tState.target ? Math.min(tState.count / tState.target, 1) : 0;
      $('#tRing').style.strokeDashoffset = RING_C * (1 - prog);
      $('#tTotal').textContent = arNum(tState.total);
    }

    $('#tasbihBtn').addEventListener('click', function () {
      tState.count++; tState.total++; vibrate(10);
      var p = document.createElement('span'); p.className = 'pulse';
      this.appendChild(p); setTimeout(function () { p.remove() }, 600);
      if (tState.target && tState.count === tState.target) {
        vibrate(50); toast('أتممت ' + arNum(tState.target) + ' ' + PHRASES[tState.phrase] + ' ✓');
      }
      renderTasbih();
    });

    $('#tReset').addEventListener('click', function () { tState.count = 0; renderTasbih(); toast('تم التصفير') });

    function setTheme(t) {
      document.body.dataset.theme = t; store.set('theme', t);
      $('#metaTheme').setAttribute('content', t === 'dark' ? '#083A2E' : '#F3EFE3');
      syncSettings();
    }

    $$('#themeSeg button').forEach(function (b) {
      b.addEventListener('click', function () { setTheme(b.dataset.t) });
    });
    $$('#fsSeg button').forEach(function (b) {
      b.addEventListener('click', function () { setFS(b.dataset.f) });
    });

    function syncSettings() {
      $$('#themeSeg button').forEach(function (b) { b.classList.toggle('on', b.dataset.t === document.body.dataset.theme) });
      $$('#fsSeg button').forEach(function (b) { b.classList.toggle('on', b.dataset.f === document.body.dataset.fs) });
    }

    (function init() {
      document.body.dataset.theme = store.get('theme', 'dark');
      document.body.dataset.fs = store.get('fs', 'm');
      $('#metaTheme').setAttribute('content', document.body.dataset.theme === 'dark' ? '#083A2E' : '#F3EFE3');
      syncSettings();
      renderHome();
      renderTasbihChips();
      renderTasbih();
    })();
  //]]>
  </script>
</body>

</html>
